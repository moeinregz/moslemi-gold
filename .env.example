# آدرس واقعی سایت با https (برای بازگشت از درگاه، فید ترب و سایت‌مپ)
SITE_URL=https://example.com
PORT=4000
# اولین مدیر کل (فقط بار اول که دیتابیس خالی است استفاده می‌شه)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# پشت nginx / cloudflare باشه 1 بذار تا IP واقعی کاربر خونده بشه
TRUST_PROXY=1

# ---------- MongoDB Atlas ----------
# آدرس کلاستر را از Atlas بردارید: Database ← Connect ← Drivers (مثل cluster0.abcde.mongodb.net)
MONGODB_HOST=CLUSTER_HOST_HERE
MONGODB_USER=your-db-user
MONGODB_PASSWORD=your-db-password
MONGODB_DB=moslemi
MONGODB_COLLECTION=moslemi
# اگر رشته‌ی اتصال کامل دارید می‌توانید فقط همین را بگذارید (بر موارد بالا اولویت دارد):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net/moslemi?retryWrites=true&w=majority
